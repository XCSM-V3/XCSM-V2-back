# Dockerfile pour Celery Worker
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Installation des dépendances système (avec retry sur les miroirs instables)
RUN for i in 1 2 3; do apt-get update -o Acquire::Retries=5 && break || sleep 5; done && \
    apt-get install -y --no-install-recommends \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    tesseract-ocr \
    tesseract-ocr-fra \
    tesseract-ocr-eng \
    poppler-utils \
    imagemagick \
    && rm -rf /var/lib/apt/lists/*

# Copie des requirements
COPY requirements.txt .
RUN pip install --no-cache-dir "setuptools<82" && \
    pip install --no-cache-dir -r requirements.txt

# Copie du code
COPY . .

# Commande Celery Worker
CMD ["celery", "-A", "xcsm_project", "worker", "--loglevel=info", "--concurrency=2", "--max-tasks-per-child=50"]
